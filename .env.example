# Copy this file to .env and fill in real values for local development.
# .env is git-ignored and never committed.
#
# All WhiteRabbit_ variables are loaded by AddEnvironmentVariables(prefix: "WhiteRabbit_").
# The prefix is stripped and __ maps to : in the config hierarchy.
# Example: WhiteRabbit_Mailjet__ApiKey  →  Mailjet:ApiKey

# Mailjet (leave empty to use SMTP/Mailpit fallback in dev)
WhiteRabbit_Mailjet__ApiKey=
WhiteRabbit_Mailjet__SecretKey=
WhiteRabbit_Mailjet__FromEmail=noreply@example.com

# Encrypts the Data Protection key ring that White Rabbit stores in its database. The key ring in turn
# protects every stored bunny.net API key, so losing this value makes them unreadable.
# Generate once with: openssl rand -base64 32
WHITE_RABBIT_DATA_PROTECTION_KEY=

# The address you sign in with. Nobody else can sign in (empty means nobody at all).
WHITE_RABBIT_ALLOWED_EMAIL=you@example.com
# Optional: allow everyone at one domain, e.g. example.com.
WHITE_RABBIT_ALLOWED_DOMAIN=
# Docker Compose only passes variables that docker-compose.yml lists. For more addresses or domains, add lines such as
#   - WhiteRabbit_Access__AllowedEmails__1=${WHITE_RABBIT_ALLOWED_EMAIL_2}
# to the white-rabbit service's environment section, and set the variable here.
