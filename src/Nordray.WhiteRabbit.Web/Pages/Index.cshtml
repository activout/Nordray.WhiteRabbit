@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<h1>White Rabbit</h1>
<p>Signed in as <strong>@Model.Email</strong></p>

<p>White Rabbit is used from the <code>rabbit</code> CLI:</p>
<ul>
    <li><code>rabbit auth login</code>: sign in the CLI</li>
    <li><code>rabbit admin key set</code>: store your bunny.net API key</li>
    <li><code>rabbit admin bindings add …</code>: let a CI workflow use it</li>
</ul>
